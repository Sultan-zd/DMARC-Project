# Copy to .env and edit. Docker Compose reads .env automatically; it is gitignored.
#
#   cp .env.example .env
#
# Every value here has a working default in docker-compose.yml, so the stack starts
# without any of them. What you lose by leaving them is written beside each one.


# ─── Database ────────────────────────────────────────────────────────────────
# Only read when the volume is first created. Changing them later does not change
# the account inside an existing database.
DB_NAME=dmarc_dashboard
DB_USERNAME=dmarc
DB_PASSWORD=
DB_ROOT_PASSWORD=

# `update` while the schema is still moving, `validate` once it matters. On
# validate the application refuses to start if the schema and the entities
# disagree, instead of altering live tables to match a mistyped field.
DB_DDL_AUTO=update


# ─── Keys ────────────────────────────────────────────────────────────────────
# Generate both once and keep them. They are not interchangeable and neither can
# be recovered.
#
#   openssl rand -base64 48     JWT_SECRET
#   openssl rand -base64 32     SECRETS_KEY
#
# On Windows without openssl:
#   [Convert]::ToBase64String((1..48 | % { Get-Random -Max 256 }))

# Signs session tokens. Unset, a throwaway key is generated at every start, so
# everyone is signed out whenever the container restarts — and the key is printed
# in the log, where anyone reading it can forge a token for any account.
JWT_SECRET=

# Encrypts stored mailbox passwords. Unset, the application refuses to store one at
# all, so no organization can have reports collected automatically. Changing it
# later makes every already-stored mailbox password unreadable.
SECRETS_KEY=


# ─── Addressing ──────────────────────────────────────────────────────────────
# The address people actually type. Confirmation and invitation links are built
# from it — left at localhost, every link you email is dead on any machine but this
# one.
PUBLIC_URL=http://localhost:8000

# The port published on the host. Change it if 8000 is taken.
APP_PORT=8000

# true only behind a reverse proxy or tunnel you control, where X-Forwarded-For is
# written by that proxy. Reachable directly, the header is whatever the caller
# says, and rate limiting stops meaning anything.
APP_TRUST_PROXY_HEADERS=false


# ─── Outgoing mail ───────────────────────────────────────────────────────────
# With no host, confirmation and invitation links go to the log rather than to
# people:  docker compose logs app
#
# Microsoft 365    smtp.office365.com : 587
# Google Workspace smtp.gmail.com     : 587
#
# Both refuse an ordinary account password over SMTP — use an app password. On
# Microsoft 365, SMTP AUTH must also be enabled for the mailbox; it is off by
# default on tenants created since 2020.
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=
MAIL_FROM_NAME=Teknologiia DMARC


# ─── First account ───────────────────────────────────────────────────────────
# Created only on an empty database. Leave the password blank and a strong one is
# generated and printed once, in the log. Sign in with it and change it.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
ADMIN_EMAIL=admin@example.com
ADMIN_ORGANIZATION=Teknologiia

# Accounts that also see the Platform console: every organization, the runtime, and
# the database. Comma-separated usernames. Empty means nobody, and the console does
# not appear at all.
PLATFORM_OPERATORS=
